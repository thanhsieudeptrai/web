<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trang Web Nhận Xét Siêu Cấp</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <!-- Thư viện tạo pháo hoa ở trang cuối -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
      body {
        font-family: "Plus Jakarta Sans", sans-serif;
      }
      .fade-in {
        animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
      }
      .evasive-btn {
        transition: transform 0.15s ease-out;
        will-change: transform;
      }
    </style>
  </head>
  <body class="bg-gray-900 text-gray-800 min-h-screen flex flex-col justify-between p-4 overflow-hidden relative select-none">
    
    <!-- BACKGROUND TOÀN MÀN HÌNH -->
    <div id="full-bg" class="fixed inset-0 z-0 transition-all duration-700">
      <img id="full-bg-img" src="" class="w-full h-full object-cover scale-105" />
      <div class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
    </div>

    <!-- CẤU HÌNH DỮ LIỆU -->
    <script>
      const URL_ANH_NEN_TRANG_DAU = "to1cute.jpg"; // Đặt file ảnh cùng thư mục
      const URL_ANH_CAU_HOI_1 = "";
      const URL_ANH_CAU_HOI_2 = "";

      const sheets = [
        {
          type: "welcome",
          title: "XIN CHÀO CẢ NHÓM! 👋",
          subtitle: "Dành ra 10 giây để đánh giá độ đẹp trai của tớ nhé!",
          bgImage: URL_ANH_NEN_TRANG_DAU,
        },
        {
          type: "troll-choice",
          title: "CÂU HỎI 1",
          question: "Bạn thấy tớ có đẹp trai không?",
          imageUrl: URL_ANH_CAU_HOI_1,
          correctOptionIndex: 3,
          options: [
            "A. Không muốn nhìn lần 2 🤮",
            "B. Trông cũng... tạm được 😐",
            "C. Bình thường, không nổi bật 😶",
            "D. Vẻ đẹp không góc chết, siêu đẹp trai! ✨",
          ],
        },
        {
          type: "troll-input",
          title: "CÂU HỎI 2",
          question: "Hãy nhập nhận xét thật lòng của bạn vào đây:",
          imageUrl: URL_ANH_CAU_HOI_2,
          forcedText: "Có! Bạn là người siêu cấp đẹp trai, dễ thương và vô cùng tốt tính! ❤️",
        },
      ];
    </script>

    <!-- CONTAINER CHÍNH -->
    <div id="main-container" class="w-full max-w-xl mx-auto min-h-screen flex flex-col justify-between items-center py-6 relative z-10">
      
      <!-- Progress Bar -->
      <div id="progress-bar-container" class="w-full bg-white/20 backdrop-blur-md h-2.5 rounded-full overflow-hidden mb-4 hidden border border-white/20">
        <div id="progress-bar" class="bg-gradient-to-r from-pink-500 to-yellow-400 h-full transition-all duration-300" style="width: 0%"></div>
      </div>

      <!-- Content -->
      <div id="app-content" class="w-full flex-1 flex flex-col justify-center items-center text-center my-auto"></div>

      <!-- Nav Button -->
      <div id="nav-buttons" class="mt-4 flex justify-center w-full hidden">
        <button id="btn-next" onclick="nextSheet()" class="px-8 py-3.5 rounded-2xl bg-gradient-to-r from-pink-500 to-rose-500 text-white font-extrabold text-lg shadow-lg active:scale-95 transition-all hover:brightness-110">
          Tiếp theo ➔
        </button>
      </div>
    </div>

    <!-- LOGIC SỬA ĐỔI -->
    <script>
      let currentSheet = 0;

      const contentDiv = document.getElementById("app-content");
      const progressBarContainer = document.getElementById("progress-bar-container");
      const progressBar = document.getElementById("progress-bar");
      const navButtons = document.getElementById("nav-buttons");
      const fullBg = document.getElementById("full-bg");
      const fullBgImg = document.getElementById("full-bg-img");

      function renderSheet() {
        const sheet = sheets[currentSheet];

        if (currentSheet > 0 && currentSheet < sheets.length) {
          progressBarContainer.classList.remove("hidden");
          const percent = (currentSheet / (sheets.length - 1)) * 100;
          progressBar.style.width = `${percent}%`;
        } else {
          progressBarContainer.classList.add("hidden");
        }

        // Welcome
        if (sheet.type === "welcome") {
          navButtons.classList.add("hidden");
          if (sheet.bgImage) fullBgImg.src = sheet.bgImage;

          contentDiv.innerHTML = `
            <div class="fade-in w-full flex flex-col items-center gap-6 py-8">
              <span class="px-4 py-1.5 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-white text-xs font-black tracking-widest uppercase shadow-sm">
                ĐỘI HÌNH SIÊU ĐÁNG YÊU
              </span>
              <div class="p-8 rounded-3xl bg-white/10 backdrop-blur-md border border-white/20 text-white shadow-2xl w-full">
                <h1 class="text-3xl sm:text-4xl font-black mb-3 tracking-wide">${sheet.title}</h1>
                <p class="text-white/80 text-base font-semibold">${sheet.subtitle}</p>
              </div>
              <button onclick="nextSheet()" class="w-full py-4 rounded-2xl bg-white text-black font-black text-lg shadow-xl hover:bg-gray-100 active:scale-95 transition">
                Bắt đầu ngay🚀
              </button>
            </div>
          `;
        }

        // Troll Choice
        else if (sheet.type === "troll-choice") {
          navButtons.classList.add("hidden");
          let imgHtml = sheet.imageUrl ? `<img src="${sheet.imageUrl}" class="w-20 h-20 object-cover rounded-2xl mb-4 border-2 border-white/40 shadow-md">` : "";

          let optionsHtml = "";
          sheet.options.forEach((opt, idx) => {
            if (idx === sheet.correctOptionIndex) {
              optionsHtml += `
                <button onclick="nextSheet()" class="w-full p-4 rounded-2xl bg-gradient-to-r from-pink-500 to-rose-500 text-white font-black hover:opacity-90 transition text-sm shadow-lg active:scale-95">
                  ${opt}
                </button>
              `;
            } else {
              optionsHtml += `
                <button onmouseenter="escapeButton(this)" onclick="escapeButton(this)" ontouchstart="escapeButton(this)" class="evasive-btn w-full p-4 rounded-2xl bg-white/80 backdrop-blur-md text-gray-900 font-extrabold text-sm relative shadow-md">
                  ${opt}
                </button>
              `;
            }
          });

          contentDiv.innerHTML = `
            <div class="fade-in w-full p-6 rounded-3xl bg-white/10 backdrop-blur-xl border border-white/20 shadow-2xl flex flex-col items-center">
              ${imgHtml}
              <span class="text-xs font-black text-pink-300 mb-1 tracking-wider uppercase">${sheet.title}</span>
              <h2 class="text-xl font-extrabold mb-6 text-white">${sheet.question}</h2>
              <div class="w-full grid grid-cols-1 sm:grid-cols-2 gap-3 min-h-[180px] relative">
                ${optionsHtml}
              </div>
            </div>
          `;
        }

        // Troll Input
        else if (sheet.type === "troll-input") {
          navButtons.classList.remove("hidden");
          let imgHtml = sheet.imageUrl ? `<img src="${sheet.imageUrl}" class="w-20 h-20 object-cover rounded-2xl mb-4 border-2 border-white/40 shadow-md">` : "";

          contentDiv.innerHTML = `
            <div class="fade-in w-full p-6 rounded-3xl bg-white/10 backdrop-blur-xl border border-white/20 shadow-2xl flex flex-col items-center">
              ${imgHtml}
              <span class="text-xs font-black text-pink-300 mb-1 tracking-wider uppercase">${sheet.title}</span>
              <h2 class="text-xl font-extrabold mb-6 text-white">${sheet.question}</h2>
              <textarea id="troll-textarea" oninput="handleTrollTyping(event)" rows="4" placeholder="Gõ bất kỳ phím nào ở đây..." class="w-full p-4 rounded-2xl bg-white/90 text-gray-900 font-bold text-base focus:outline-none focus:ring-4 focus:ring-pink-500/50 transition resize-none shadow-inner"></textarea>
            </div>
          `;
          setTimeout(() => document.getElementById("troll-textarea")?.focus(), 100);
        }

        // End Sheet
        else if (sheet.type === "end") {
          navButtons.classList.add("hidden");
          confetti({ particleCount: 120, spread: 70, origin: { y: 0.6 } });
          contentDiv.innerHTML = `
            <div class="fade-in text-center p-8 rounded-3xl bg-white/10 backdrop-blur-xl border border-white/20 shadow-2xl max-w-md text-white">
              <div class="text-5xl mb-4">🎉</div>
              <h2 class="text-3xl font-black mb-2">Biết thế là tốt!</h2>
              <p class="text-white/80 font-bold text-base">Cảm ơn bạn đã nhận xét cực kỳ chân thực về tớ nha! 🤣</p>
            </div>
          `;
        }
      }

      // Giới hạn nút không chạy khỏi khung nhìn màn hình
      function escapeButton(btn) {
        const maxX = 80;
        const maxY = 60;
        const randomX = (Math.random() - 0.5) * maxX * 2;
        const randomY = (Math.random() - 0.5) * maxY * 2;
        btn.style.transform = `translate(${randomX}px, ${randomY}px)`;
      }

      function handleTrollTyping(e) {
        const sheet = sheets[currentSheet];
        const targetText = sheet.forcedText;
        const textarea = e.target;
        const currentLen = textarea.value.length;
        textarea.value = targetText.substring(0, currentLen);
      }

      function nextSheet() {
        if (currentSheet < sheets.length - 1) {
          currentSheet++;
        } else if (sheets[currentSheet].type !== "end") {
          sheets.push({ type: "end" });
          currentSheet++;
        }
        renderSheet();
      }

      renderSheet();
    </script>
  </body>
</html>
